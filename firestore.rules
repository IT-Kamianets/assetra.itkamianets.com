rules_version = '2';

// Firestore rules of project vroom-8ef42, shared by VRoom and Assetra. This is the full published
// set: keep the VRoom `interiors` block when changing it, and publish the whole file in
// Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // VRoom: user interiors with floors and spaces.
    match /interiors/{interiorId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /floors/{floorId}/spaces/{spaceId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/interiors/$(interiorId)).data.ownerId == request.auth.uid;
      }
    }

    // Assetra below.
    function signedIn() {
      return request.auth != null;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // '' (no collection) or one of the signed-in author's collections.
    function ownCollection(id) {
      return id == '' || get(/databases/$(database)/documents/collections/$(id)).data.uid == request.auth.uid;
    }

    function text(field, max) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= max;
    }

    // Models users upload from their profile (/account → "Мої моделі").
    match /models/{modelId} {
      allow read: if true;

      allow create: if ownsNew()
        && text('title', 120) && request.resource.data.title.size() > 0
        && text('description', 2000)
        && text('collectionId', 40) && ownCollection(request.resource.data.collectionId)
        && request.resource.data.modelUrl is string
        && request.resource.data.modelUrl.matches('https://cdn-it[.]webart[.]work/assetka/.*');

      // Owners may only move a model between their collections.
      allow update: if ownsExisting()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collectionId'])
        && text('collectionId', 40) && ownCollection(request.resource.data.collectionId);

      allow delete: if ownsExisting();
    }

    // Same list as environment.adminEmails; keep both in sync.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['alina.siruk26@gmail.com', 'ceo@webart.work', 'kristinaolefirenko5@gmail.com'];
    }

    // Catalog assets published from /admin; the document id is the slug. Each admin edits only their own.
    match /assets/{slug} {
      allow read: if true;

      allow create: if isAdmin() && ownsNew()
        && request.resource.data.slug == slug
        && text('title', 200) && request.resource.data.title.size() > 0;

      allow update: if isAdmin() && ownsExisting() && ownsNew()
        && request.resource.data.slug == slug
        && text('title', 200) && request.resource.data.title.size() > 0;

      allow delete: if isAdmin() && ownsExisting();
    }

    // Authors' collections (/account → "Мої колекції", public at /collections).
    match /collections/{collectionId} {
      allow read: if true;

      allow create: if ownsNew()
        && text('title', 80) && request.resource.data.title.size() > 0
        && text('description', 1000);

      // The owner may edit text and the cover; uid and createdAt stay as they were.
      allow update: if ownsExisting()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && text('title', 80) && request.resource.data.title.size() > 0
        && text('description', 1000);

      allow delete: if ownsExisting();
    }

    // Public profile of a signed-in user (/account). The document id is the user's uid and it holds
    // no email. Anyone may read it; only its owner writes it.
    match /profiles/{uid} {
      allow read: if true;

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[a-z0-9_]{3,20}$')
        && text('name', 60)
        && text('bio', 280)
        && text('role', 20)
        && text('city', 60)
        && text('portfolio', 300)
        && text('instagram', 300)
        && text('behance', 300)
        && text('artstation', 300);

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Nickname registry: the id is the lowercase nickname, so a nickname can be claimed only once.
    // Creating over an existing id counts as an update, which is not allowed.
    match /nicknames/{nickname} {
      allow read: if true;

      allow create: if signedIn()
        && nickname.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
